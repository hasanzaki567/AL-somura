# Al-Sumora Environment Variables Configuration

# Database Connection (MongoDB Atlas)
MONGO_URI=
# JWT Authentication Secret Key
JWT_SECRET= 

# Admin Credentials
ADMIN_EMAIL=your_admin_email@domain.com
ADMIN_PASSWORD=your_secure_admin_password

# ImageKit Configuration for Media Storage & CDN
IMAGEKIT_URL_ENDPOINT= 
IMAGEKIT_PUBLIC_KEY= 
IMAGEKIT_PRIVATE_KEY= 

# Server Configuration
PORT=5000
NODE_ENV=production

# Google Identity Services (OAuth Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Resend Email Configuration (Store Order Notifications)
RESEND_API_KEY=your_resend_api_key_here
OWNER_EMAIL=al.sumora.support@gmail.com
RESEND_FROM_EMAIL=Store Orders <onboarding@resend.dev>
RESEND_CUSTOMER_FROM_EMAIL=AL-SOMURA <onboarding@resend.dev>
SUPPORT_EMAIL=al.sumora.support@gmail.com
